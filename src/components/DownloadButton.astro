---
import { Icon } from "astro-icon/components";
---

<a
    href="/Alejo%20Sarmiento%20Curriculum%20Vitae.pdf"
    download="Alejo Sarmiento Curriculum Vitae.pdf"
    class="download-button noprint"
    aria-label="Descargar Currículum Vitae"
>
    <Icon name="mdi:download" />
    <span>Descargar Currículum Vitae</span>
</a>

<style>
    .download-button {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 0;
        height: 3.1rem;
        padding: 0 0.95rem;
        border-radius: 999px;
        border: 1px solid #000;
        background: #000;
        color: #fff;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.4);
        overflow: hidden;
        white-space: nowrap;
        cursor: pointer;
        font: inherit;
        text-decoration: none;
        transition:
            gap 0.3s ease,
            background-color 0.2s ease,
            border-color 0.2s ease;
    }
    .download-button :global(svg) {
        width: 1.35rem;
        height: 1.35rem;
        flex-shrink: 0;
    }
    .download-button span {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        transition:
            max-width 0.35s ease,
            opacity 0.25s ease;
    }
    .download-button:hover,
    .download-button:focus-visible {
        gap: 0.6rem;
        background: #333;
        border-color: #333;
    }
    .download-button:hover span,
    .download-button:focus-visible span {
        max-width: 22rem;
        opacity: 1;
    }
    @media (max-width: 600px) {
        .download-button {
            right: 1rem;
            bottom: 1rem;
        }
    }
    @media print {
        .download-button {
            display: none;
        }
    }
</style>
