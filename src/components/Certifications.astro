---
import { certifications, certificationsInProgress } from "../data";

const featured = certifications.filter((c) => c.featured);
const others = certifications.filter((c) => !c.featured);
---

<section class="certificates" id="certificates">
    <h2 class="title">
        Certificaciones <a href="#certificates" class="pilcrow">&para;</a>
    </h2>
    <hr />
    <p>
        <b>En curso:</b>{" "}
        {
            certificationsInProgress.map((c, i) => (
                <>
                    {c.title} ({c.institution}, {c.date})
                    {i < certificationsInProgress.length - 1 ? "; " : "."}
                </>
            ))
        }
    </p>
    <p>
        <b>Destacadas:</b>{" "}
        {
            featured.map((c, i) => (
                <>
                    <a href={c.certificateUrl} target="_blank">{c.title}</a> ({c.institution}, {c.date})
                    {i < featured.length - 1 ? "; " : "."}
                </>
            ))
        }
    </p>
    <p>
        <b>Otras:</b>{" "}
        {
            others.map((c, i) => (
                <>
                    <a href={c.certificateUrl} target="_blank">{c.title}</a> ({c.institution}, {c.date})
                    {i < others.length - 1 ? "; " : "."}
                </>
            ))
        }
    </p>
</section>

<style>
    .certificates p {
        margin-bottom: 0.5em;
    }

    .certificates a {
        text-decoration: underline;
    }

    @media print {
        .certificates a {
            text-decoration: none;
        }
    }
</style>
